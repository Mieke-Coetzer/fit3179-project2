{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 750,
  "height": 450,
  "title": {
    "text": "Digital Acceleration Matrix: Internet Growth",
    "subtitle": "Percentage point growth over two-year intervals across countries"
  },
  "data": {
    "url": "js/data/internet_users_clean.csv"
  },
  "transform": [
    {
      "calculate": "datum['\ufeffCountry Name'] != null ? datum['\ufeffCountry Name'] : datum['Country Name']",
      "as": "Country"
    },
    {
      "filter": "indexof(['World', 'Australia', 'China', 'India', 'United States', 'United Kingdom', 'Japan', 'Brazil', 'South Africa', 'Indonesia'], datum.Country) >= 0"
    },
    {
      "fold": ["1994", "1996", "1998", "2000", "2002", "2004", "2006", "2008", "2010", "2012", "2014", "2016", "2018", "2020", "2022", "2024", "2026"],
      "as": ["Year", "Percentage"]
    },
    {
      "filter": "isValid(datum.Percentage) && datum.Percentage != '' && datum.Percentage != null"
    },
    {
      "calculate": "toNumber(datum.Percentage)",
      "as": "Percentage_Num"
    },
    {
      "window": [{"op": "lag", "field": "Percentage_Num", "as": "Prev_Percentage"}],
      "groupby": ["Country"],
      "sort": [{"field": "Year", "order": "ascending"}]
    },
    {
      "calculate": "datum.Prev_Percentage == null ? null : datum.Percentage_Num - datum.Prev_Percentage",
      "as": "Change_2Yrs"
    },
    {
      "filter": "isValid(datum.Change_2Yrs) && datum.Year != '2000'"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Period (2-Year Intervals)",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "Country",
      "type": "nominal",
      "title": "Country",
      "sort": ["World", "Australia", "United States", "United Kingdom", "Japan", "China", "Brazil", "Indonesia", "South Africa", "India"]
    },
    "color": {
      "field": "Change_2Yrs",
      "type": "quantitative",
      "title": "Growth (%)",
      "scale": {
        "scheme": "redblue",
        "domain": [-30, 30]
      }
    },
    "tooltip": [
      {"field": "Country", "type": "nominal", "title": "Country"},
      {"field": "Year", "type": "ordinal", "title": "Year"},
      {"field": "Percentage_Num", "type": "quantitative", "title": "Internet Adoption (%)", "format": ".1f"},
      {"field": "Change_2Yrs", "type": "quantitative", "title": "Growth (%)", "format": "+.1f"}
    ]
  }
}