{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Interactive Global Internet Adoption (1990-2026)",
    "fontSize": 18
  },
  "width": 900,
  "height": 577,
  "projection": {"type": "equalEarth"},
  "params": [
    {
      "name": "Year_Select",
      "value": 2026,
      "bind": {
        "input": "range",
        "min": 1990,
        "max": 2026,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e9e8ee", "stroke": "white", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [
        {
          "lookup": "properties.ISO_A3",
          "from": {
            "data": {"url": "js/data/internet_users_clean.csv"},
            "key": "Country Code",
            "fields": ["Country Name",
              "1990", "1991", "1992", "1993", "1994", "1995", "1996", "1997", "1998", "1999",
              "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009",
              "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019",
              "2020", "2021", "2022", "2023", "2024", "2025", "2026"
            ]
          }
        },
        {
          "fold": ["1990", "1991", "1992", "1993", "1994", "1995", "1996", "1997", "1998", "1999",
            "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009",
            "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019",
            "2020", "2021", "2022", "2023", "2024", "2025", "2026"
          ],
          "as": ["Year", "Adoption_Rate"]
        },
        {"filter": "datum.Year == Year_Select"}
      ],
      "mark": {"type": "geoshape"},
      "encoding": {
        "color": {
          "field": "Adoption_Rate",
          "type": "quantitative",
          "scale": {"scheme": "purplebluegreen", "domain": [0,100]},
          "title": "Adoption Rate (%)"
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {"field": "Year", "type": "nominal", "title": "Year"},
          {"field": "Adoption_Rate", "type": "quantitative", "title": "Internet Adoption (%)", "format": ".2f"}
        ]
      }
    }
  ]
}