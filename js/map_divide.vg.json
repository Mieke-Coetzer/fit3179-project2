{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 750,
  "title": "Metro vs Regional Classification",
  "projection": {
    "type": "mercator",
    "center": [133.0, -27.0],
    "scale": 950
  },
  "layer": [
    {
      "data": {
        "url": "js/ne_10m_admin_1_states_provinces.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f8fafc",
        "stroke": "#cbd5e1",
        "strokeWidth": 1
      },
      "transform": [
        {
          "filter": "datum.properties.admin == 'Australia'"
        }
      ]
    },
    {
      "data": {
        "url": "js/ne_10m_populated_places.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_populated_places"
        }
      },
      "transform": [
        {
          "calculate": "indexof(['Sydney', 'Melbourne', 'Perth', 'Adelaide', 'Darwin', 'Canberra', 'Hobart', 'Newcastle', 'Wollongong', 'Geelong', 'Cranbourne', 'Melton', 'Sunbury', 'Kwinana'], datum.properties.NAME) >= 0 ? 'Metro' : 'Regional'",
          "as": "Classification"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 70,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "properties.LONGITUDE",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.LATITUDE",
          "type": "quantitative"
        },
        "color": {
          "field": "Classification",
          "type": "nominal",
          "title": "Area Type",
          "scale": {
            "domain": ["Metro", "Regional"],
            "range": ["#1f4e78", "#e2b13c"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Area Classification"
          }
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Place"},
          {"field": "properties.ADM1NAME", "type": "nominal", "title": "State/Territory"},
          {"field": "Classification", "type": "nominal", "title": "Classification"}
        ]
      }
    }
  ]
}