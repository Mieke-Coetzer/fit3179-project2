{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 400,
  "title": {
    "text": "NBN Technology Migration Shift (2024 vs 2025)",
    "fontSize": 16,
    "subtitle": "Comparison of connection volumes between June 2024 and June 2025"
  },
  "data": {
    "url": "data/trends_clean.csv"
  },
  "transform": [
    {
      "calculate": "lower(trim(datum['\ufeffTechnology'] != null ? datum['\ufeffTechnology'] : (datum['Technology'] != null ? datum['Technology'] : '')))",
      "as": "Tech_Clean"
    },
    {
      "filter": "indexof(['fttp', 'fttn', 'fttc', 'hfc', 'wireless', 'satellite'], datum.Tech_Clean) >= 0"
    },
    {
      "fold": ["June 2024", "June 2025"],
      "as": ["Period", "Volume"]
    },
    {
      "filter": "isValid(datum.Volume) && datum.Volume != ''"
    },
    {
      "calculate": "toNumber(datum.Volume)",
      "as": "Volume_Num"
    }
  ],
  "mark": {
    "type": "line",
    "point": {"size": 80},
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "Period",
      "type": "ordinal",
      "title": "Time Period",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "Volume_Num",
      "type": "quantitative",
      "title": "Connection Volume",
      "scale": {"zero": false}
    },
    "color": {
      "field": "Tech_Clean",
      "type": "nominal",
      "title": "NBN Technology",
      "scale": {"scheme": "category10"}
    },
    "tooltip": [
      {"field": "Tech_Clean", "type": "nominal", "title": "Technology"},
      {"field": "Period", "type": "ordinal", "title": "Period"},
      {"field": "Volume_Num", "type": "quantitative", "title": "Volume", "format": ",.0f"}
    ]
  }
}