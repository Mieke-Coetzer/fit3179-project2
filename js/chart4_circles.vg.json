{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 420,
  "title": {
    "text": "Digital Communication Purposes & Impacts Scatter",
    "fontSize": 16,
    "anchor": "middle"
  },
  "data": {
    "url": "js/data/purposes_clean.csv"
  },
  "config": {
    "view": {
      "stroke": "#dcdcdc",
      "strokeWidth": 1
    }
  },
  "transform": [
    {
      "window": [{"op": "row_number", "as": "id"}]
    },
    {
      "calculate": "datum.id == 1 ? 1.5 : datum.id == 2 ? 2.8 : datum.id == 3 ? 1.3 : datum.id == 4 ? 2.6 : datum.id == 5 ? 8.0 : datum.id == 6 ? 7.1 : datum.id == 7 ? 8.2 : datum.id == 8 ? 5.2 : datum.id == 9 ? 4.2 : datum.id == 10 ? 5.5 : datum.id == 11 ? 6.8 : datum.id == 12 ? 6.0 : datum.id == 13 ? 3.0 : datum.id == 14 ? 4.0 : datum.id == 15 ? 2.2 : 4.8",
      "as": "x_pos"
    },
    {
      "calculate": "datum.id == 1 ? 3.8 : datum.id == 2 ? 2.1 : datum.id == 3 ? 1.6 : datum.id == 4 ? 4.1 : datum.id == 5 ? 1.5 : datum.id == 6 ? 2.8 : datum.id == 7 ? 3.8 : datum.id == 8 ? 1.8 : datum.id == 9 ? 4.0 : datum.id == 10 ? 3.6 : datum.id == 11 ? 1.4 : datum.id == 12 ? 2.3 : datum.id == 13 ? 3.2 : datum.id == 14 ? 1.7 : datum.id == 15 ? 1.2 : 2.8",
      "as": "y_pos"
    }
  ],
  "encoding": {
    "x": {
      "field": "x_pos",
      "type": "quantitative",
      "axis": null,
      "scale": {"domain": [0.5, 9.0]}
    },
    "y": {
      "field": "y_pos",
      "type": "quantitative",
      "axis": null,
      "scale": {"domain": [0.5, 4.8]}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.9
      },
      "encoding": {
        "size": {
          "field": "weight",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "range": [500, 7500]
          },
          "legend": null
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": ["Personal", "Professional", "Media", "Social", "Impact", "Infrastructure"],
            "range": ["#1f4e78", "#599e99", "#c65d3b", "#7d7085", "#e2b13c", "#b0c4de"]
          },
          "legend": {
            "title": "Category Domain",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {"field": "word", "type": "nominal", "title": "Purpose / Theme"},
          {"field": "category", "type": "nominal", "title": "Category"},
          {"field": "weight", "type": "quantitative", "title": "Weight Score"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": "center",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "text": {
          "field": "word",
          "type": "nominal"
        }
      }
    }
  ]
}