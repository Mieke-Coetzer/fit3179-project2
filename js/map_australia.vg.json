{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 550,
  "title": {
    "text": "Australia: State-Level Metro vs. Regional Classification",
    "fontSize": 16
  },
  "projection": {
    "type": "mercator",
    "center": [133, -27],
    "scale": 750
  },
  "data": {
    "url": "ne_10m_admin_1_states_provinces.json",
    "format": {
      "type": "topojson",
      "feature": "ne_10m_admin_1_states_provinces"
    }
  },
  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "data/state_classification.csv"
        },
        "key": "State_Name",
        "fields": ["Primary_Classification", "Adoption_Rate"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "Primary_Classification",
      "type": "nominal",
      "title": "Classification",
      "scale": {
        "domain": ["Metro-Dominant", "Regional-Dominant"],
        "range": ["#1f77b4", "#2ca02c"]
      }
    },
    "tooltip": [
      {"field": "properties.name", "type": "nominal", "title": "State / Territory"},
      {"field": "Primary_Classification", "type": "nominal", "title": "Dominant Zone"},
      {"field": "Adoption_Rate", "type": "quantitative", "title": "Avg. Adoption Rate (%)"}
    ]
  }
}