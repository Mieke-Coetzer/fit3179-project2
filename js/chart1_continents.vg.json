{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  
  "title": {
    "text": "Regional Internet Growth",
    "subtitle": "Percentage of population using the internet across global regions",
    "fontSize": 14,
    "subtitleFontSize": 12
  },
  
  "width": 760,
  "height": 400,
  
  "data": {
    "url": "js/data/internet_users_clean.csv"
  },
  
  "transform": [
    {
      "filter": {
        "field": "Country Code",
        "oneOf": ["NAC", "ECS", "EAS", "LCN", "MEA", "SSF"]
      }
    },
    {
      "fold": [
        "1990", "1991", "1992", "1993", "1994", "1995", "1996", "1997", "1998", "1999",
        "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009",
        "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019",
        "2020", "2021", "2022", "2023", "2024", "2025", "2026"
      ],
      "as": ["Year_Str", "Users"]
    },
    {
      "calculate": "parseInt(datum.Year_Str)",
      "as": "Year"
    },
    {
      "calculate": "datum.Users == null ? null : parseFloat(datum.Users)",
      "as": "Users_Total"
    },
    {
      "calculate": "datum['Country Code'] == 'EAS' ? 'Asia & Pacific' : datum['Country Code'] == 'ECS' ? 'Europe' : datum['Country Code'] == 'SSF' ? 'Africa' : datum['Country Code'] == 'NAC' ? 'North America' : datum['Country Code'] == 'LCN' ? 'Latin America' : 'Middle East'",
      "as": "Continents"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "continentHighlight",
          "select": {"type": "point", "fields": ["Continents"]},
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "line": {"strokeWidth": 2},
        "fillOpacity": 0.4,
        "point": false
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": [1990, 2026],
            "nice": false
          },
          "axis": {
            "format": "d",
            "tickCount": 10,
            "grid": false
          }
        },
        "y": {
          "field": "Users_Total",
          "type": "quantitative",
          "title": "Internet Users (% of Population)",
          "stack": null,
          "axis": {
            "format": ".0f",
            "grid": true
          }
        },
        "color": {
          "field": "Continents",
          "type": "nominal",
          "title": "Continents",
          "scale": {
            "scheme": "set3"
          }
        },
        "opacity": {
          "condition": {"param": "continentHighlight", "value": 1},
          "value": 1
        },
        "tooltip": [
          {"field": "Continents", "type": "nominal", "title": "Continents"},
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "Users_Total", "type": "quantitative", "title": "Adoption Rate (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4]
      },
      "data": {
        "values": [
          {"Year": 1995},
          {"Year": 2005},
          {"Year": 2012}
        ]
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontStyle": "italic",
        "align": "left",
        "dx": 4,
        "dy": 15
      },
      "data": {
        "values": [
          {"Year": 1995, "label": "1995: Pioneer Era"},
          {"Year": 2005, "label": "2005: Web 2.0 Inflection"},
          {"Year": 2012, "label": "2012: Mobile Surge"}
        ]
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"value": 0},
        "text": {"field": "label"}
      }
    }
  ]
}